# =========================================================================
# Puja Parikrama Environment Configuration
# Copy this file to .env and fill in your Supabase & n8n settings
# =========================================================================

# n8n Webhook URL for photo uploads & moderation
VITE_N8N_WEBHOOK_URL=https://gairikz8.app.n8n.cloud/webhook/parikrama-upload

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
